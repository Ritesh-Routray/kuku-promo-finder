# Copy to .env and fill in. Free keys:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Web app only
ACCESS_CODE=            # unlocks protected (Kuku) runs in the web app
HF_TOKEN=               # read token for the private demo dataset (Spaces only)
DEMO_DATASET=           # e.g. your-username/kuku-promo-demo (private dataset repo)
